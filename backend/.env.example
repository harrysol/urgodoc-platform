# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="UrgoDoc Fashion 3D Try-On API"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Comma-separated list of allowed CORS origins for the Expo / React Native client.
# Use "*" for local development only.
CORS_ORIGINS="*"

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/urgodoc"

# ── Celery / Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# ── Vision LLM (Anthropic Claude) ─────────────────────────────────────────────
# Used for structured product-metadata + garment-dimension extraction from the
# scraped product screenshot.
ANTHROPIC_API_KEY="sk-ant-..."
VISION_MODEL="claude-opus-4-8"

# ── Tripo3D (2D image → .glb generation) ──────────────────────────────────────
TRIPO3D_API_KEY="tsk_..."
TRIPO3D_BASE_URL="https://api.tripo3d.ai/v2/openapi"
TRIPO3D_POLL_INTERVAL=5
TRIPO3D_POLL_TIMEOUT=600

# ── Headless scraper / residential proxy ──────────────────────────────────────
# Leave the proxy values empty to scrape without a proxy (local dev).
SCRAPER_PROXY_SERVER=""            # e.g. "http://gate.residential-proxy.io:8000"
SCRAPER_PROXY_USERNAME=""
SCRAPER_PROXY_PASSWORD=""
SCRAPER_TIMEOUT_MS=45000
SCREENSHOT_DIR="/tmp/urgodoc/screenshots"

# ── Affiliate monetization ────────────────────────────────────────────────────
# Skimlinks/Sovrn auto-affiliates any merchant link. Amazon tag is a fallback for
# amazon.* domains. Both optional; if unset, the original URL is returned as-is.
SKIMLINKS_PUBLISHER_ID=""
AMAZON_ASSOCIATE_TAG=""
